<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><%@ include file="/WEB-INF/views/fragments/admin-head.jspf" %><title>Overview | MHAM AUTO Management</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/premium.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/ui-polish.css"><script defer src="${pageContext.request.contextPath}/assets/js/premium-interactions.js"></script>
<script defer src="${pageContext.request.contextPath}/assets/js/ui-polish.js"></script>
</head>
<body><%@ include file="/WEB-INF/views/fragments/admin-shell-start.jspf" %><main id="main-content" class="a8-main mh-shell">
<div class="a8-top"><div><p class="a8-kicker">STORE MANAGEMENT / OVERVIEW</p><h1>Welcome back<c:if test="${not empty sessionScope.authUser.displayName}">, <c:out value="${sessionScope.authUser.displayName}"/></c:if>.</h1><p>Here's what's happening across your catalogue, customers and demonstration orders.</p></div><a class="a8-action" href="${pageContext.request.contextPath}/admin/product">+ Add product</a></div>
<div class="a8-stats"><div class="a8-stat"><span>Total products</span><strong><c:out value="${summary.products}"/></strong></div><div class="a8-stat"><span>Published products</span><strong><c:out value="${summary.published}"/></strong></div><div class="a8-stat"><span>Registered customers</span><strong><c:out value="${customerCount}"/></strong></div><div class="a8-stat"><span>Demo orders</span><strong><c:out value="${summary.demoOrders}"/></strong></div><div class="a8-stat"><span>Demo orders to review</span><strong><c:out value="${summary.pendingOrders}"/></strong></div><div class="a8-stat"><span>Variants</span><strong><c:out value="${summary.variants}"/></strong></div><div class="a8-stat"><span>Sample stock ≤ 5</span><strong><c:out value="${summary.lowStock}"/></strong></div><div class="a8-stat"><span>Categories</span><strong><c:out value="${summary.categories}"/></strong></div></div>
<section class="pro-admin-callout"><div><h2>Keep your catalogue ready</h2><p>Review listing visibility, demo pricing and product information in one workspace.</p></div><a href="${pageContext.request.contextPath}/admin/products">Manage catalogue</a></section>
<section class="a8-panel"><div class="a8-title-row"><h2>Recent demonstration orders</h2><a class="pro-clear-filter" href="${pageContext.request.contextPath}/admin/orders">View all orders</a></div><div class="a8-scroll"><table class="a8-table"><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Demo total</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${recentOrders}" var="ord"><tr><td><strong><c:out value="${ord.reference}"/></strong></td><td><c:out value="${ord.buyer}"/></td><td><c:out value="${ord.createdAt}"/></td><td>KWD <c:out value="${ord.total}"/></td><td><span class="pro-status-pill"><c:out value="${ord.status}"/></span></td><td><a href="${pageContext.request.contextPath}/admin/order?id=<c:out value='${ord.id}'/>">Review</a></td></tr></c:forEach><c:if test="${empty recentOrders}"><tr><td colspan="6"><div class="pro-empty-table">No demonstration orders have been placed yet.</div></td></tr></c:if></tbody></table></div></section>
<section class="a8-panel"><div class="a8-title-row"><h2>Quick actions</h2></div><div class="pro-admin-grid-tiles"><a href="${pageContext.request.contextPath}/admin/products">Product catalogue <span>Browse and edit your parts</span></a><a href="${pageContext.request.contextPath}/admin/categories">Categories <span>Organize product taxonomy</span></a><a href="${pageContext.request.contextPath}/admin/customers">Customers <span>View customer accounts</span></a><a href="${pageContext.request.contextPath}/admin/orders">Orders <span>Review demo transactions</span></a><a href="${pageContext.request.contextPath}/admin/trade-applications">Trade applications <span>Review business enquiries</span></a><a href="${pageContext.request.contextPath}/">Storefront <span>View the customer experience</span></a></div></section>
<p class="a8-warning"><strong>Demonstration environment:</strong> Customer checkout does not accept real payments or initiate fulfilment. Inventory and some prices are unverified sample values.</p>
</main><%@ include file="/WEB-INF/views/fragments/admin-shell-end.jspf" %></body></html>
