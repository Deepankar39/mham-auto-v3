<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><%@ include file="/WEB-INF/views/fragments/admin-head.jspf" %><title>Manage Products | MHAM AUTO</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/premium.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/ui-polish.css">
<script defer src="${pageContext.request.contextPath}/assets/js/premium-interactions.js"></script>
<script defer src="${pageContext.request.contextPath}/assets/js/ui-polish.js"></script>
</head>
<body><%@ include file="/WEB-INF/views/fragments/admin-shell-start.jspf" %><main id="main-content" class="a8-main mh-shell">
  <div class="a8-top"><div><p class="a8-kicker">PRODUCT MANAGEMENT</p><h1>Catalogue &amp; stock</h1><p>Manage source-aware catalogue records. Deactivate rather than delete products.</p></div><a class="a8-action" href="${pageContext.request.contextPath}/admin/product">+ New product</a></div>
  
  <form class="a8-search" action="${pageContext.request.contextPath}/admin/products" method="get"><label for="a8-search">Handle or SKU prefix</label><input type="search" id="a8-search" name="q" value="<c:out value='${search}'/>" maxlength="80" placeholder="Search handle or SKU prefix"><label for="pro-status-filter">Status</label><select id="pro-status-filter" name="status"><option value="">All statuses</option><option value="active" ${statusFilter eq 'active' ? 'selected' : ''}>Active</option><option value="draft" ${statusFilter eq 'draft' ? 'selected' : ''}>Draft</option><option value="archived" ${statusFilter eq 'archived' ? 'selected' : ''}>Archived</option></select><button type="submit">Filter products</button><a class="pro-clear-filter" href="${pageContext.request.contextPath}/admin/products">Clear</a></form>
  <div class="a8-panel"><div class="a8-title-row"><h2>Products</h2><span><c:out value="${results.total}"/> records</span></div>
  <div class="a8-scroll"><table class="a8-table"><thead><tr><th>Product</th><th>SKU</th><th>Sample stock</th><th>Demo KWD</th><th>Visibility</th><th>Action</th></tr></thead><tbody>
    <c:forEach var="p" items="${results.items}"><tr><td><div class="pro-admin-product-cell"><c:choose><c:when test="${not empty p.imageUrl}"><img class="pro-admin-product-thumb" src="<c:out value='${p.imageUrl}'/>" alt="" width="52" height="52" loading="lazy"></c:when><c:otherwise><img class="pro-admin-product-thumb" src="${pageContext.request.contextPath}/assets/images/parts-placeholder.svg" alt="" width="52" height="52" loading="lazy"></c:otherwise></c:choose><div><strong><c:out value="${p.title}"/></strong><small><c:out value="${p.handle}"/></small><small><c:out value="${p.vendor}"/></small></div></div></td><td><c:out value="${p.sku}"/></td><td><c:out value="${p.sourceStock}" default="Unknown"/></td><td><c:choose><c:when test="${not empty p.demoPrice}"><c:out value="${p.demoPrice}"/></c:when><c:otherwise>Unverified</c:otherwise></c:choose></td><td><c:out value="${p.status}"/> · <c:out value="${p.published ? 'Public' : 'Hidden'}"/></td><td><div class="pro-table-actions"><a href="${pageContext.request.contextPath}/admin/product?id=<c:out value='${p.id}'/>">Edit</a><c:if test="${p.status ne 'archived'}"><form method="post" action="${pageContext.request.contextPath}/admin/product/archive" data-confirm="Archive this product and remove it from public listings? Historical orders will be retained."><input type="hidden" name="csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="<c:out value='${p.id}'/>"><button class="pro-archive-action" type="submit">Archive</button></form></c:if></div></td></tr></c:forEach>
    <c:if test="${empty results.items}"><tr><td colspan="6">No products match this query.</td></tr></c:if>
  </tbody></table></div>
  <nav class="a8-pages" aria-label="Product list pagination"><c:if test="${results.hasPrevious}"><c:url var="prevUrl" value="/admin/products"><c:param name="page" value="${results.page - 1}"/><c:param name="q" value="${search}"/><c:param name="status" value="${statusFilter}"/></c:url><a href="${prevUrl}">← Previous</a></c:if><span>Page <c:out value="${results.page}"/></span><c:if test="${results.hasNext}"><c:url var="nextUrl" value="/admin/products"><c:param name="page" value="${results.page + 1}"/><c:param name="q" value="${search}"/><c:param name="status" value="${statusFilter}"/></c:url><a href="${nextUrl}">Next</a></c:if></nav></div>
</main><%@ include file="/WEB-INF/views/fragments/admin-shell-end.jspf" %></body></html>
