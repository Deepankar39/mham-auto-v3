<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><%@ include file="/WEB-INF/views/fragments/admin-head.jspf" %><title>Categories | MHAM AUTO</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/premium.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/ui-polish.css">
<script defer src="${pageContext.request.contextPath}/assets/js/premium-interactions.js"></script>
<script defer src="${pageContext.request.contextPath}/assets/js/ui-polish.js"></script>
</head>
<body><%@ include file="/WEB-INF/views/fragments/admin-shell-start.jspf" %><main id="main-content" class="a8-main mh-shell">
<div class="a8-top"><div><p class="a8-kicker">CATALOGUE MANAGEMENT</p><h1>Categories</h1><p>Create and organize categories while protecting imported source taxonomy.</p></div></div>
<c:if test="${saved}"><p class="a8-success" role="status">Category added.</p></c:if>
<div class="a8-grid"><form class="a8-panel a8-form" method="post" action="${pageContext.request.contextPath}/admin/categories">
<input type="hidden" name="action" value="create">
<input type="hidden" name="csrf" value="<c:out value='${csrfToken}'/>"><h2>Add category</h2><label for="a8-category-name">Category name</label><input id="a8-category-name" name="name" maxlength="190" required placeholder="Cooling System"><button type="submit">Create category</button><p>Imported taxonomy is protected. Rename and delete operate only on administrator-created categories; deletion requires an empty category.</p></form>
<section class="a8-panel"><h2>Existing categories</h2><ul class="a8-cat-list"><c:forEach var="cat" items="${categories}"><li class="pro-category-admin-row"><c:choose><c:when test="${cat.managed}"><form method="post" action="${pageContext.request.contextPath}/admin/categories" class="pro-category-rename"><input type="hidden" name="csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="<c:out value='${cat.id}'/>"><input type="hidden" name="action" value="rename"><label class="sr-only" for="cat-<c:out value='${cat.id}'/>">Category name</label><input id="cat-<c:out value='${cat.id}'/>" name="name" maxlength="190" value="<c:out value='${cat.name}'/>" required><button type="submit" title="Rename administrator-created category">Rename</button></form><form method="post" action="${pageContext.request.contextPath}/admin/categories" data-confirm="Delete this category? Only empty administrator-created categories can be removed."><input type="hidden" name="csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="<c:out value='${cat.id}'/>"><input type="hidden" name="action" value="delete"><button class="pro-category-delete" type="submit" title="Delete empty administrator-created category">Delete</button></form></c:when><c:otherwise><strong><c:out value="${cat.name}"/></strong><small class="pro-category-imported">Imported · read only</small></c:otherwise></c:choose></li></c:forEach><c:if test="${empty categories}"><li>None yet.</li></c:if></ul></section></div>
</main><%@ include file="/WEB-INF/views/fragments/admin-shell-end.jspf" %></body></html>
