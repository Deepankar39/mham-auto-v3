<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><%@ include file="/WEB-INF/views/fragments/admin-head.jspf" %><title>Customers | MHAM AUTO Management</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/premium.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/ui-polish.css"><script defer src="${pageContext.request.contextPath}/assets/js/premium-interactions.js"></script>
<script defer src="${pageContext.request.contextPath}/assets/js/ui-polish.js"></script>
</head><body>
<%@ include file="/WEB-INF/views/fragments/admin-shell-start.jspf" %>
<main id="main-content" class="a8-main mh-shell"><div class="a8-top"><div><p class="a8-kicker">CUSTOMER DIRECTORY</p><h1>Customers</h1><p>View registered customer accounts and their demonstration order totals. Sensitive credentials and account administration are not exposed.</p></div></div>
<form class="a8-search" method="get" action="${pageContext.request.contextPath}/admin/customers"><label for="customer-search">Find a customer</label><input id="customer-search" type="search" name="q" maxlength="80" value="<c:out value='${search}'/>" placeholder="Email or display name (prefix)"><button type="submit">Search customers</button><a href="${pageContext.request.contextPath}/admin/customers" class="pro-clear-filter">Clear</a></form>
<section class="a8-panel"><div class="a8-title-row"><h2>Registered customers</h2><span><c:out value="${results.total}"/> records</span></div><div class="a8-scroll"><table class="a8-table"><thead><tr><th>Customer</th><th>Email</th><th>Registered</th><th>Account status</th><th>Demo orders</th></tr></thead><tbody><c:forEach items="${results.items}" var="person"><tr><td><strong><c:out value="${person.displayName}"/></strong><small>Customer #<c:out value="${person.id}"/></small></td><td><c:out value="${person.email}"/></td><td><c:out value="${person.createdAt}"/></td><td><span class="pro-status-pill"><c:out value="${person.status}"/></span></td><td><c:out value="${person.orderCount}"/></td></tr></c:forEach><c:if test="${empty results.items}"><tr><td colspan="5"><div class="pro-empty-table">No customers found. Try a different name or email prefix.</div></td></tr></c:if></tbody></table></div>
<nav class="a8-pages" aria-label="Customer pagination"><c:if test="${results.hasPrevious}"><c:url var="older" value="/admin/customers"><c:param name="page" value="${results.page-1}"/><c:param name="q" value="${search}"/></c:url><a href="${older}">← Previous</a></c:if><span>Page <c:out value="${results.page}"/></span><c:if test="${results.hasNext}"><c:url var="newer" value="/admin/customers"><c:param name="page" value="${results.page+1}"/><c:param name="q" value="${search}"/></c:url><a href="${newer}">Next</a></c:if></nav></section>
</main><%@ include file="/WEB-INF/views/fragments/admin-shell-end.jspf" %>
</body></html>
