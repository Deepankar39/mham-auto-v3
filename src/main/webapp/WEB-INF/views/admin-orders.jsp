<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><%@ include file="/WEB-INF/views/fragments/admin-head.jspf" %><title>Demo Orders | MHAM AUTO</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/premium.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/ui-polish.css">
<script defer src="${pageContext.request.contextPath}/assets/js/premium-interactions.js"></script>
<script defer src="${pageContext.request.contextPath}/assets/js/ui-polish.js"></script>
</head>
<body><%@ include file="/WEB-INF/views/fragments/admin-shell-start.jspf" %><main id="main-content" class="a8-main mh-shell">
<div class="a8-top"><div><p class="a8-kicker">DEMONSTRATION ORDER MANAGEMENT</p><h1>Demo orders</h1><p>Review demo customer checkouts. No real payments or fulfilment.</p></div></div>
<form action="${pageContext.request.contextPath}/admin/orders" method="get" class="a8-search"><label for="a8-statusfilter">Review status</label><select id="a8-statusfilter" name="status"><option value="">All statuses</option><option value="DEMO_PLACED" ${statusFilter eq 'DEMO_PLACED' ? 'selected="selected"' : ''}>Placed</option><option value="DEMO_REVIEWED" ${statusFilter eq 'DEMO_REVIEWED' ? 'selected="selected"' : ''}>Reviewed</option><option value="DEMO_CANCELLED" ${statusFilter eq 'DEMO_CANCELLED' ? 'selected="selected"' : ''}>Cancelled</option></select><button type="submit">Apply</button></form>
<section class="a8-panel"><div class="a8-title-row"><h2>Order records</h2><span><c:out value="${results.total}"/> total</span></div><div class="a8-scroll"><table class="a8-table"><thead><tr><th>Reference</th><th>Customer</th><th>Demo total</th><th>Created</th><th>Status</th><th></th></tr></thead><tbody>
<c:forEach var="o" items="${results.items}"><tr><td><strong><c:out value="${o.reference}"/></strong></td><td><c:out value="${o.buyer}"/></td><td>KWD <c:out value="${o.total}"/></td><td><c:out value="${o.createdAt}"/></td><td><c:out value="${o.status}"/></td><td><a href="${pageContext.request.contextPath}/admin/order?id=<c:out value='${o.id}'/>">Review</a></td></tr></c:forEach><c:if test="${empty results.items}"><tr><td colspan="6">No orders found.</td></tr></c:if>
</tbody></table></div><nav class="a8-pages" aria-label="Order pagination"><c:if test="${results.hasPrevious}"><c:url var="prevUrl" value="/admin/orders"><c:param name="page" value="${results.page - 1}"/><c:param name="status" value="${statusFilter}"/></c:url><a href="${prevUrl}">← Previous</a></c:if><span>Page <c:out value="${results.page}"/></span><c:if test="${results.hasNext}"><c:url var="nextUrl" value="/admin/orders"><c:param name="page" value="${results.page + 1}"/><c:param name="status" value="${statusFilter}"/></c:url><a href="${nextUrl}">Next</a></c:if></nav></section>
</main><%@ include file="/WEB-INF/views/fragments/admin-shell-end.jspf" %></body></html>
