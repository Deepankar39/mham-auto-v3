<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:choose>
<c:when test="${empty featured}"><div class="pro-featured-fallback"><strong>Explore our growing collection</strong><p>There are no published catalogue products to feature just yet.</p><a href="${pageContext.request.contextPath}/products">Browse catalogue</a></div></c:when>
<c:otherwise><c:forEach items="${featured}" var="item">
<article class="pro-product-card"><a href="${pageContext.request.contextPath}<c:out value='${item.url}'/>" class="pro-product-picture"><c:choose><c:when test="${not empty item.imageUrl}"><img loading="lazy" decoding="async" src="<c:out value='${item.imageUrl}'/>" alt="<c:out value='${item.title}'/>" width="260" height="210"></c:when><c:otherwise><img loading="lazy" src="${pageContext.request.contextPath}/assets/images/parts-placeholder.svg" alt="Product image unavailable" width="100" height="100"></c:otherwise></c:choose></a><div class="pro-product-body"><span class="pro-product-overline"><c:out value="${item.vendor}"/></span><h3><a href="${pageContext.request.contextPath}<c:out value='${item.url}'/>"><c:out value="${item.title}"/></a></h3><p>SKU <c:out value="${item.sku}"/></p><div class="pro-product-price"><strong><c:out value="${item.priceLabel}"/></strong><a href="${pageContext.request.contextPath}<c:out value='${item.url}'/>" aria-label="View product details"><svg class="mh-icon" aria-hidden="true"><use href="#mh-icon-arrow-right"/></svg></a></div></div></article>
</c:forEach></c:otherwise></c:choose>
